# Dependencies
/node_modules
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/
__pycache__/
*.py[cod]

# OS metadata
.DS_Store

# Borrower sources, extraction ledgers, answers, output and credentials stay private.
/samples/
/sample-data/
/uploads/
/upload/
/results/
/evaluations/
/evaluation-private/
/actual-runs/
*.pdf
*.docx
*.xlsx
*.hwp
*.zip
!public/templates/*.docx
/public/pdf.worker.min.mjs

# Local evaluator tied to private source fixtures.
/scripts/run-sample-evaluation.py
