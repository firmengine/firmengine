      "effect": "TERM_REVIEW_CANDIDATE"
    },
    {
      "id": "INTAKE.INSURANCE_MISSING",
      "authority": "FIRM_POLICY",
      "evaluation": "보험료 흐름은 있으나 본인 계약·환급가치 미확인",
      "effect": "REQUEST_EVIDENCE",
      "required_document": "해약환급금·계약자 자료",
