# Existing ../.env is loaded automatically; OPEN_AI_API_KEY is also supported.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
API_PORT=8010
N8N_PORT=5679
# n8n 2.x task broker must use a different port from the editor.
N8N_RUNNERS_BROKER_PORT=5680
OCR_CONCURRENCY=3
OCR_BATCH_PAGES=4
SESSION_TTL_SECONDS=3600
